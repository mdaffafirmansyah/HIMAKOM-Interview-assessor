# ====================================================================
# HimaKom AI Interview Assessor - Environment Variables Template
# ====================================================================
# PENTING: Salin file ini menjadi .env.local dan isi nilai kredensial yang sah.
# Jangan menambahkan nilai rahasia asli ke dalam file template ini atau ke Git!

# 1. Konfigurasi Database Supabase Cloud (Tahap Integrasi Berikutnya)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Konfigurasi Speech-to-Text & Evaluasi AI (Akan dikonfigurasi saat integrasi siap)
# VITE_GROQ_API_KEY=your-groq-api-key-here
# VITE_OPENAI_API_KEY=your-openai-api-key-here
